{
	"name": "robin-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "node --experimental-strip-types scripts/build-sveltekit.ts",
		"build:cdn": "node --experimental-strip-types scripts/build-cdn-sveltekit.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"coverage": "vitest run --coverage",
		"generate-icons": "tsx scripts/generate-icons.ts",
		"inject-env": "node --experimental-strip-types scripts/inject-env.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260702.1",
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.5",
		"@fontsource/fira-mono": "^5.2.7",
		"@neoconfetti/svelte": "^2.2.2",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.69.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@sveltejs/vite-plugin-svelte-inspector": "^5.0.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^25.9.5",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^16.5.0",
		"jsdom": "^26.1.0",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"pwa-asset-generator": "^8.1.5",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.2",
		"tailwindcss": "^4.3.2",
		"ts-node": "^10.9.2",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.64.0",
		"vite": "^7.3.6",
		"vitest": "^4.1.10",
		"vitest-sonar-reporter": "^3.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"overrides": {
			"cookie@<0.7.0": "^0.7.0"
		}
	},
	"dependencies": {
		"@inlang/paraglide-js": "^2.22.0",
		"@lucide/svelte": "^0.562.0",
		"@zumer/snapdom": "^2.16.0",
		"daisyui": "^5.6.18",
		"fast-xml-parser": "^5.10.0"
	}
}
