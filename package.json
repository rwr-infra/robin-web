{
	"name": "robin-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "node --experimental-strip-types scripts/build-sveltekit.ts",
		"build:cdn": "node --experimental-strip-types scripts/build-cdn-sveltekit.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"coverage": "vitest run --coverage",
		"generate-icons": "tsx scripts/generate-icons.ts",
		"inject-env": "node --experimental-strip-types scripts/inject-env.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260804.1",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@neoconfetti/svelte": "^2.2.2",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/node": "^26.1.2",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"pwa-asset-generator": "^8.1.5",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"ts-node": "^10.9.2",
		"tsx": "^4.23.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.0",
		"vitest": "^4.1.10",
		"vitest-sonar-reporter": "^3.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"overrides": {
			"cookie@<0.7.0": "^0.7.0"
		}
	},
	"dependencies": {
		"@inlang/paraglide-js": "^2.23.1",
		"@lucide/svelte": "^1.28.0",
		"@zumer/snapdom": "^2.23.2",
		"daisyui": "^5.7.16",
		"fast-xml-parser": "^5.10.1"
	}
}
